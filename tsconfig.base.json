{
    // Strictness and interop shared by every TypeScript workspace. Module and
    // runtime settings live in tsconfig.bundler.json (the browser-bundled
    // workspaces) and apps/api/tsconfig.json (Node, CommonJS).
    "compilerOptions": {
        "target": "ES2022",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true
    }
}
