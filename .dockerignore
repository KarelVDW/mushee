# Keep build contexts small and reproducible — and keep local-only files out of
# the images: the API stage copies apps/api wholesale, so anything not listed
# here ends up in the production container.
**/node_modules
# Local environment files carry real keys (SendGrid, Polar sandbox, admin
# secret); only the documented example may ship.
**/.env*
!**/.env.example
# Local blob storage (dev recordings + scores) and test/dev-only trees.
apps/api/storage
apps/api/test
apps/api/scripts
apps/api/coverage
**/test-results
**/playwright-report
**/.venv*
**/dist
**/*.tsbuildinfo
**/.git
**/debug
**/fixtures/eval
**/fixtures/eval-real
**/scripts/eval/.cache
**/*.sf2
**/*.log
# Exclude the web app's source, but keep its package.json so pnpm can resolve the
# workspace for --frozen-lockfile (the API image never builds web).
apps/web
!apps/web/package.json
