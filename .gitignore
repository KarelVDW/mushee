apps/api/scripts/eval/.freesound-token
apps/api/scripts/fixtures/eval/
apps/api/scripts/fixtures/eval-real/
# Cached pitch trajectories for the eval harness — derived, large, and rebuilt on
# demand by scripts/eval/lib/trackCache.ts (and, per acoustic condition, by
# scripts/eval/lib/variantCache.ts).
apps/api/scripts/fixtures/eval-cache/
apps/api/scripts/fixtures/eval-cache-variant/
# Python gRPC stubs are generated, not committed: at image build (Dockerfiles'
# proto stage) or on the host via packages/inference-proto/generate-python.sh
apps/inference-*/inference_pb2.py
apps/inference-*/inference_pb2_grpc.py
apps/api/scripts/eval/.tmp-contour/
# Machine-drafted label files for corpora whose truth is regenerated deterministically
# by fetcher + aligner (fetch/fetch-humtrans.ts → fetch/align-prescribed-truth.ts).
# Hand-corrected labels are the only artefact worth committing; commit a clip's TSV
# once a human has verified it (fetch/import-note-labels.ts --verified-by).
apps/api/scripts/eval/annotations/humtrans-aligned/
