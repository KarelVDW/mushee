{
    "name": "@mushee/ui",
    "version": "0.0.0",
    "private": true,
    "description": "Solkey's shared design-system kit for the web app, the admin console and the eval workbench: the primitives (Brand, Buttons, Feedback, Icon, Inputs, Toast, RenderBoundary), the theme tokens, the HTTP error model + QueryClient setup, and the open-redirect guard. Shipped as TypeScript source — consuming apps compile it with their own bundler (Next: transpilePackages).",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./http": "./src/http.ts",
        "./nextPath": "./src/nextPath.ts",
        "./queryClient": "./src/queryClient.ts",
        "./testing/nextPathFuzz": "./src/testing/nextPathFuzz.ts",
        "./theme.css": "./src/theme.css"
    },
    "scripts": {
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.101.0",
        "next": "^16.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@tanstack/react-query": "^5.101.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "next": "16.1.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "typescript": "^5.0.0",
        "vitest": "^4.1.5"
    }
}
