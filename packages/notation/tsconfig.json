{
    // The consuming Next apps' settings: this package never compiles on its
    // own (no build script) — apps transpile the source, tsc only checks.
    "extends": "../../tsconfig.bundler.json",
    "compilerOptions": {
        // scripts/ run on Node's type stripping, which needs explicit `.ts` import paths.
        "allowImportingTsExtensions": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
    "exclude": ["node_modules"]
}
